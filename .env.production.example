# ReviewAI Production Environment Configuration Template

# Server Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-64-character-key-string-in-prod

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=reviewai
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_DB=reviewai_db

# Redis Cache & Queue Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@redis:6379/0

# GitHub Integration & App Secrets
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_hmac_secret

# AI & OpenAI LLM API Keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Notification Webhook Defaults (Optional)
DEFAULT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXXX
DEFAULT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123/xyz

# Domain & CORS Origins
CORS_ORIGINS=https://reviewai.yourdomain.com
