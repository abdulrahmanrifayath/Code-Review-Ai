ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=reviewai
POSTGRES_PASSWORD=reviewai_pass
POSTGRES_DB=reviewai_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://reviewai:reviewai_pass@localhost:5432/reviewai_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o
