# ==========================================
# ReviewAI - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="ReviewAI"
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL)
POSTGRES_USER=reviewai
POSTGRES_PASSWORD=reviewai_pass
POSTGRES_DB=reviewai_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://reviewai:reviewai_pass@db:5432/reviewai_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# GitHub Integration
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# AI & LLM Provider Settings
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
